---
// Rota /registro-de-marca/[slug]/: só segmentos (ex.: restaurantes).
// Cidades vivem exclusivamente em /registro-de-marca/[municipio]/[uf]/
// (ver [municipio]/[uf].astro) — inclusive as cidadesDestaque, que já têm
// conteúdo personalizado lá. Um slug de cidade aqui também nunca existiu
// como link interno (o hub em index.astro só aponta para a versão longa),
// então essa página curta era órfã e duplicada: mesmo conteúdo, canonical
// apontando pra outra URL, e as duas listadas no sitemap ao mesmo tempo.
// Removida para não sinalizar conteúdo duplicado pro Google (GSC:
// "Rastreada, mas não indexada no momento").
import { segmentos } from '../../data/segmentos';
import SegmentoPage from '../../components/pages/SegmentoPage.astro';

export function getStaticPaths() {
  return segmentos.map((segmento) => ({
    params: { slug: segmento.slug },
    props: { segmento }
  }));
}

const { segmento } = Astro.props;
---
<SegmentoPage segmento={segmento} />
