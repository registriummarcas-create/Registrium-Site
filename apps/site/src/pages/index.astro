---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { contactConfig } from '../config/contact';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import PurposeManifesto from '../components/sections/PurposeManifesto.astro';
import InstagramEmbed from '../components/sections/InstagramEmbed.astro';
import MarksShowcase from '../components/sections/MarksShowcase.astro';
import CostOfWaiting from '../components/sections/CostOfWaiting.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import VideoShowcase from '../components/sections/VideoShowcase.astro';
import IncludedFees from '../components/sections/IncludedFees.astro';
import Compare from '../components/sections/Compare.astro';
import InvestmentSimulator from '../components/sections/InvestmentSimulator.astro';
import PaymentClarity from '../components/sections/PaymentClarity.astro';
import Services from '../components/sections/Services.astro';
import FAQInline from '../components/sections/FAQInline.astro';
import ReferralFaq from '../components/sections/ReferralFaq.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';

const logoUrl = new URL('/images/logo-full.png', siteConfig.url).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteConfig.name,
    legalName: 'Registrium Copyright e Marcas',
    url: siteConfig.url,
    logo: logoUrl,
    image: logoUrl,
    description: siteConfig.description,
    email: contactConfig.email,
    telephone: `+${contactConfig.whatsappNumber}`,
    taxID: contactConfig.cnpj,
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'PB',
      addressCountry: 'BR'
    },
    areaServed: { '@type': 'Country', name: 'Brasil' },
    sameAs: [contactConfig.instagramUrl]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url,
    inLanguage: siteConfig.locale,
    publisher: { '@type': 'Organization', name: siteConfig.name }
  }
];
---
<BaseLayout jsonLd={jsonLd}>
  <Hero />
  <PurposeManifesto />
  <InstagramEmbed />
  <Features />
  <MarksShowcase chapter="04" />
  <CostOfWaiting />
  <HowItWorks />
  <VideoShowcase />
  <IncludedFees />
  <Compare />
  <InvestmentSimulator chapter="09" />
  <PaymentClarity />
  <Services />
  <FAQInline />
  <ReferralFaq />
  <FinalCTA />
</BaseLayout>
