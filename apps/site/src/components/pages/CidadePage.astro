---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import MarksShowcase from '../sections/MarksShowcase.astro';
import { cidades, type Cidade } from '../../data/cidades';
import { getFontesEstaduais } from '../../data/fontes-estaduais';
import { siteConfig } from '../../config/site';

interface Props { cidade: Cidade }
const { cidade } = Astro.props;
const fontesEstado = getFontesEstaduais(cidade.uf);
const numero = new Intl.NumberFormat('pt-BR');
const percentual = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });
const moedaCompacta = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', notation: 'compact', maximumFractionDigits: 2 });
const ibgeUrl = `https://www.ibge.gov.br/cidades-e-estados/${cidade.uf}/${cidade.slug}.html`;
const setorPredominante = Object.entries({
  Serviços: cidade.participacaoSetorial2021.servicos,
  'Administração pública': cidade.participacaoSetorial2021.administracaoPublica,
  Indústria: cidade.participacaoSetorial2021.industria,
  Agropecuária: cidade.participacaoSetorial2021.agropecuaria
}).sort((a, b) => b[1] - a[1])[0]?.[0] ?? 'Perfil diversificado';

const canonical = new URL(`/registro-de-marca/${cidade.slug}/${cidade.uf}/`, siteConfig.url).toString();

const todasOutras = cidades
  .filter((c) => c.uf === cidade.uf && c.slug !== cidade.slug)
  .sort((a, b) => b.pib2023 - a.pib2023);
const outras = todasOutras.slice(0, 2);
const cidadesRelacionadas = todasOutras.slice(0, 12);
const related = [
  ...outras.map((c) => ({
    href: `/registro-de-marca/${c.slug}/${c.uf}/`,
    tag: c.regiao,
    title: `Registro de marca em ${c.nome}`,
    description: c.heroDescription
  })),
  {
    href: '/registro-de-marca/',
    tag: 'Todos os ramos',
    title: 'Registro de marca por segmento',
    description: 'Veja o conteúdo específico para o seu ramo de atividade.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Registro de marca em ${cidade.nome}`,
    serviceType: 'Registro de marca no INPI',
    description: cidade.seoDescription,
    areaServed: { '@type': 'City', name: `${cidade.nome}, ${cidade.uf.toUpperCase()}` },
    provider: {
      '@type': 'Organization',
      name: 'Registrium',
      url: siteConfig.url
    },
    url: canonical
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cidade.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Registro de marca', item: new URL('/registro-de-marca/', siteConfig.url).toString() },
      { '@type': 'ListItem', position: 3, name: `Em ${cidade.nome}`, item: canonical }
    ]
  }
];
---
<ArticleLayout
  title={cidade.seoTitle}
  description={cidade.seoDescription}
  pill={`${cidade.nome} · ${cidade.uf.toUpperCase()}`}
  heroTitle={cidade.heroTitle}
  heroDescription={cidade.heroDescription}
  meta={cidade.meta}
  backHref="/registro-de-marca/"
  backLabel="Registro de marca"
  toc={[
    { href: '#sobre', label: `Registrar em ${cidade.nome}` },
    { href: '#panorama', label: 'Panorama local' },
    { href: '#dados-e-fontes', label: 'Dados e fontes locais' },
    { href: '#setores', label: 'Setores da região' },
    { href: '#como', label: 'Como funciona' },
    { href: '#marcas', label: 'Marcas que já registramos' },
    { href: '#faq', label: 'Perguntas frequentes' },
    { href: '#outras-cidades', label: `Outras cidades de ${cidade.estado}` }
  ]}
  related={related}
  jsonLd={jsonLd}
>
  <div class="art-block" id="sobre">
    <h2>Registro de marca em {cidade.nome}</h2>
    <p class="lede">{cidade.lede}</p>
    {cidade.contexto.map((p) => <p>{p}</p>)}
  </div>

  <div class="art-block" id="panorama">
    <h2>Panorama do empreendedorismo local</h2>
    {cidade.panorama.map((p) => <p>{p}</p>)}
    <p><small style="color:var(--color-muted);">Fontes: {cidade.fontes.join(' · ')}.</small></p>
  </div>

  <div class="art-block" id="dados-e-fontes">
    <h2>Dados econômicos e fontes de {cidade.nome}</h2>
    <dl class="economic-data">
      <div><dt>População estimada</dt><dd>{numero.format(cidade.populacao2025)} <small>habitantes (2025)</small></dd></div>
      <div><dt>PIB municipal</dt><dd>{cidade.pib2023 ? moedaCompacta.format(cidade.pib2023 * 1_000) : 'Aguardando divulgação'} {cidade.pib2023 > 0 && <small>(2023)</small>}</dd></div>
      <div><dt>PIB por habitante</dt><dd>{cidade.pibPerCapita2023 ? moedaCompacta.format(cidade.pibPerCapita2023) : 'Aguardando divulgação'} {cidade.pibPerCapita2023 > 0 && <small>(2023)</small>}</dd></div>
      <div><dt>Setor com maior participação</dt><dd>{cidade.pib2023 ? setorPredominante : 'Aguardando divulgação'} {cidade.pib2023 > 0 && <small>(2021)</small>}</dd></div>
    </dl>
    {cidade.pib2023 > 0 && (
      <>
        <h3>Participação no valor adicionado municipal</h3>
        <ul class="plain sector-shares">
          <li>Serviços: <strong>{percentual.format(cidade.participacaoSetorial2021.servicos)}%</strong></li>
          <li>Administração pública: <strong>{percentual.format(cidade.participacaoSetorial2021.administracaoPublica)}%</strong></li>
          <li>Indústria: <strong>{percentual.format(cidade.participacaoSetorial2021.industria)}%</strong></li>
          <li>Agropecuária: <strong>{percentual.format(cidade.participacaoSetorial2021.agropecuaria)}%</strong></li>
        </ul>
      </>
    )}
    <h3>Consulte as fontes e instituições</h3>
    <ul class="plain source-links">
      <li><a href={ibgeUrl} target="_blank" rel="noopener noreferrer">IBGE — panorama oficial de {cidade.nome}</a></li>
      {cidade.wikipediaUrl && <li><a href={cidade.wikipediaUrl} target="_blank" rel="noopener noreferrer">Wikipédia — artigo sobre {cidade.nome}</a></li>}
      <li><a href={fontesEstado.sebrae.url} target="_blank" rel="noopener noreferrer">{fontesEstado.sebrae.nome}</a> — {fontesEstado.sebrae.descricao}</li>
      {fontesEstado.tecnologiaPublica && (
        <li><a href={fontesEstado.tecnologiaPublica.url} target="_blank" rel="noopener noreferrer">{fontesEstado.tecnologiaPublica.nome}</a> — {fontesEstado.tecnologiaPublica.descricao}</li>
      )}
    </ul>
    <p><small style="color:var(--color-muted);">População: SIDRA/IBGE 2025. PIB: IBGE 2023. Participação setorial: IBGE 2021. Os artigos da Wikipédia foram vinculados pelo código municipal do IBGE no Wikidata.</small></p>
  </div>

  <div class="art-block" id="setores">
    <h2>Setores em destaque na região</h2>
    <p>Atendemos negócios de todos os ramos em {cidade.nome} e no entorno. Alguns setores que mais buscam proteção de marca por aqui:</p>
    <ul class="plain">
      {cidade.setores.map((s) => <li>{s}</li>)}
    </ul>
    <p>Seja qual for o seu ramo, veja também o conteúdo específico por <a href="/registro-de-marca/" style="color:var(--color-violet);font-weight:600;">segmento de atividade</a>.</p>
  </div>

  <div class="art-block" id="como">
    <h2>Como funciona, à distância</h2>
    <p>Todo o processo é online e acompanhado de perto: você fala com a gente pelo WhatsApp e recebe atualizações a cada movimentação no INPI.</p>
    <div class="step-mini">
      <div class="sn">1</div>
      <div>
        <h3>Pesquisa de viabilidade</h3>
        <p>Analisamos o banco do INPI para verificar se o nome está livre e apontar riscos antes de qualquer investimento.</p>
      </div>
    </div>
    <div class="step-mini">
      <div class="sn">2</div>
      <div>
        <h3>Protocolo do pedido</h3>
        <p>Classificamos a marca, ajustamos a logo e depositamos o pedido — a partir daí você já tem prioridade sobre terceiros.</p>
      </div>
    </div>
    <div class="step-mini">
      <div class="sn">3</div>
      <div>
        <h3>Acompanhamento até o certificado</h3>
        <p>Monitoramos o processo diariamente, cuidamos de exigências e defendemos a marca em oposições até a concessão.</p>
      </div>
    </div>
    <p>Entenda cada etapa em detalhe no nosso guia <a href="/blog/como-funciona-registro" style="color:var(--color-violet);font-weight:600;">o passo a passo do registro de marca no INPI</a>.</p>
  </div>

  <MarksShowcase slot="marks" carouselOnly />

  <div class="art-block" id="faq">
    <h2>Perguntas frequentes</h2>
    {cidade.faq.map((item) => (
      <div class="step-mini">
        <div class="sn">?</div>
        <div>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="art-block" id="outras-cidades">
    <h2>Registro de marca em outras cidades de {cidade.estado}</h2>
    <p>A Registrium atende empresas em todo o Brasil. Veja o conteúdo específico para outras cidades do estado:</p>
    <ul class="city-links plain">
      {cidadesRelacionadas.map((c) => (
        <li><a href={`/registro-de-marca/${c.slug}/${c.uf}/`}>Registro de marca em {c.nome}</a> <span class="city-links-region">— {c.regiao}</span></li>
      ))}
    </ul>
    <p>Veja também o <a href="/registro-de-marca/" style="color:var(--color-violet);font-weight:600;">guia completo por ramo de atividade</a>, com o conteúdo específico para o seu segmento.</p>
  </div>
</ArticleLayout>
<style>
.city-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: .5rem 1.5rem; }
.city-links a { color: var(--color-violet); font-weight: 600; text-decoration: none; }
.city-links a:hover { text-decoration: underline; }
.city-links-region { color: var(--color-muted); font-size: .84rem; }
.economic-data { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 1.25rem 0 1.5rem; }
.economic-data > div { border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1rem; }
.economic-data dt { color: var(--color-muted); font-size: .8rem; margin-bottom: .3rem; }
.economic-data dd { color: var(--color-text); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; margin: 0; }
.economic-data small { color: var(--color-muted); font-family: inherit; font-weight: 500; }
.sector-shares { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .45rem 1rem; }
.source-links a { color: var(--color-violet); font-weight: 600; }
@media (max-width: 560px) { .city-links { grid-template-columns: 1fr; } }
@media (max-width: 560px) { .economic-data, .sector-shares { grid-template-columns: 1fr; } }
</style>
