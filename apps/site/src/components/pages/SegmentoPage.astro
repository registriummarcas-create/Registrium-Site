---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { segmentos, type Segmento } from '../../data/segmentos';
import { siteConfig } from '../../config/site';

interface Props { segmento: Segmento }
const { segmento } = Astro.props;

const canonical = new URL(`/registro-de-marca/${segmento.slug}/`, siteConfig.url).toString();

// Outros segmentos para a seção "Continue lendo".
const outros = segmentos.filter((s) => s.slug !== segmento.slug).slice(0, 2);
const related = [
  ...outros.map((s) => ({
    href: `/registro-de-marca/${s.slug}/`,
    tag: s.pill,
    title: `Registro de marca para ${s.alvo}`,
    description: s.heroDescription
  })),
  {
    href: '/registro-de-marca/',
    tag: 'Todos os ramos',
    title: 'Ver todos os segmentos e cidades',
    description: 'Escolha o seu ramo ou a sua cidade e veja como proteger a marca no INPI.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Registro de marca para ${segmento.alvo}`,
    serviceType: 'Registro de marca no INPI',
    description: segmento.seoDescription,
    areaServed: { '@type': 'Country', name: 'Brasil' },
    provider: {
      '@type': 'Organization',
      name: 'Registrium',
      url: siteConfig.url
    },
    url: canonical
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: segmento.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Registro de marca', item: new URL('/registro-de-marca/', siteConfig.url).toString() },
      { '@type': 'ListItem', position: 3, name: `Para ${segmento.alvo}`, item: canonical }
    ]
  }
];
---
<ArticleLayout
  title={segmento.seoTitle}
  description={segmento.seoDescription}
  pill={segmento.pill}
  heroTitle={segmento.heroTitle}
  heroDescription={segmento.heroDescription}
  meta={segmento.meta}
  backHref="/registro-de-marca/"
  backLabel="Registro de marca por ramo"
  toc={[
    { href: '#sobre', label: 'Por que registrar' },
    { href: '#panorama', label: 'Panorama do setor' },
    { href: '#classes', label: 'Classes a proteger' },
    { href: '#riscos', label: 'Riscos do setor' },
    { href: '#faq', label: 'Perguntas frequentes' }
  ]}
  related={related}
  jsonLd={jsonLd}
>
  <div class="art-block" id="sobre">
    <h2>Por que registrar a marca no seu ramo</h2>
    <p class="lede">{segmento.lede}</p>
    {segmento.intro.map((p) => <p>{p}</p>)}
  </div>

  <div class="art-block" id="panorama">
    <h2>Panorama do setor</h2>
    {segmento.panorama.map((p) => <p>{p}</p>)}
    <p><small style="color:var(--color-muted);">Fontes: {segmento.fontes.join(' · ')}.</small></p>
  </div>

  <div class="art-block" id="classes">
    <h2>Classes do INPI que se aplicam ao seu negócio</h2>
    <p>O registro de marca é feito por <strong>classe</strong> — cada uma cobre um tipo de produto ou serviço, segundo a Classificação Internacional de Nice, adotada pelo INPI. A 13ª edição está em vigor no Brasil desde 1º de janeiro de 2026, com 45 classes ao todo (34 de produtos e 11 de serviços). Para {segmento.alvo}, estas são as principais a considerar:</p>
    {segmento.classes.map((classe) => (
      <div class="step-mini">
        <div class="sn">{classe.code}</div>
        <div>
          <h3>{classe.label}</h3>
          <p>{classe.note}</p>
        </div>
      </div>
    ))}
    <p>Na pesquisa de viabilidade, definimos exatamente quais classes fazem sentido para o seu caso — protegendo o que importa sem pagar por classes que você não usa.</p>
    <p><small style="color:var(--color-muted);">Fonte: <a href="https://www.gov.br/inpi/pt-br/servicos/marcas/classificacao-marcas" target="_blank" rel="noreferrer" style="color:var(--color-violet);">Classificação de Nice — gov.br/inpi</a>.</small></p>
  </div>

  <div class="art-block" id="riscos">
    <h2>Riscos e cuidados típicos do setor</h2>
    <ul class="plain">
      {segmento.riscos.map((r) => <li>{r}</li>)}
    </ul>
  </div>

  <div class="art-block" id="faq">
    <h2>Perguntas frequentes</h2>
    {segmento.faq.map((item) => (
      <div class="step-mini">
        <div class="sn">?</div>
        <div>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      </div>
    ))}
  </div>
</ArticleLayout>
